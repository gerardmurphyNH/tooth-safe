# NexusYou Environment Variables
# Copy this file to .env and fill in your values

# ─── Anthropic Claude API ────────────────────────────────────────────────────
# Used for AI Coach feedback, exercise generation, and Prompt Playground
# Get your key at: https://console.anthropic.com/
# IMPORTANT: For internal tools only. Use a backend proxy for public-facing apps.
VITE_ANTHROPIC_API_KEY=sk-ant-...

# ─── Progress Tracking Webhook (Google Sheets) ───────────────────────────────
# Deploy the Apps Script in google-apps-script/webhook.gs and paste the URL here
# See README.md for setup instructions
VITE_GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ─── Slack Webhook ───────────────────────────────────────────────────────────
# Create an Incoming Webhook in your Slack workspace
# Add it to the #pde channel (or whichever channel you prefer)
# Instructions: https://api.slack.com/messaging/webhooks
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── App Configuration ───────────────────────────────────────────────────────
# The Slack channel to post to (without #)
VITE_SLACK_CHANNEL=pde

# Claude model to use (claude-sonnet-4-6 recommended)
VITE_CLAUDE_MODEL=claude-sonnet-4-6
