# ──────────────────────────────────────────────────────────────────────────────
# ToothSafe — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────────────────

# Google Sheets Lead Capture (SHARED with wigglytoothworkshop.com)
# This is the SAME Apps Script URL used on the sister site.
# Copy the value from wigglytoothworkshop.com's Vercel env vars,
# or from ~/magical-mission-hub/src/lib/config.ts.
# No changes to the Apps Script are needed.
NEXT_PUBLIC_GOOGLE_SHEETS_ENDPOINT=https://script.google.com/macros/s/AKfycbz2eBNfo2WqNoaV5Gm4Nq6KlzBUMa1b-0sZCGtoYdjFJBpuXFExb3p1SlRi1hcYBv0U4g/exec

# Google Analytics 4 (shared GA property — same as wigglytoothworkshop.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8M7LNF6VW7

# YouTube Video ID (from your YouTube URL: youtube.com/watch?v=VIDEO_ID)
# Leave blank to show the placeholder player.
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=
